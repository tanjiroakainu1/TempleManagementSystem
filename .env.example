# Local Express API (npm run dev)
PORT=3001

# Temple Wisdom AI — required for Candy Oracle chat
# On Vercel: Project → Settings → Environment Variables
OPENROUTER_API_KEY=your_secret_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: public site URL for OpenRouter referer (local / custom domain)
PUBLIC_APP_URL=http://localhost:5173

# Auto-set on Vercel deployments (do not set manually unless needed)
# VERCEL_URL=your-project.vercel.app
